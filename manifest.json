{
  "manifest_version": 3,
  "name": "RepoGloss — GitHubの英語用語に日本語の解説",
  "version": "1.8.8",
  "description": "GitHubの英語UIはそのままに、Git／GitHub固有の用語に印を付け、カーソルを乗せると日本語の解説が出ます。初学者向け。GitHub, Inc.とは無関係の非公式ツールです。",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "action": {
    "default_title": "RepoGloss — 表示の切り替えは GitHub のページ右下のボタンから",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/matcher.js", "src/content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["locales/dict.json"],
      "matches": ["https://github.com/*"]
    }
  ]
}
