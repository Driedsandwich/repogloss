{
  "manifest_version": 3,
  "name": "RepoGloss — GitHubの英語用語に日本語の解説",
  "version": "1.6.0",
  "description": "GitHubの英語UIはそのままに、Git／GitHub固有の用語へ🛈で日本語の解説をそえます。初学者向け。GitHub, Inc.とは無関係の非公式ツールです。",
  "permissions": ["storage"],
  "action": {
    "default_title": "RepoGloss"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://github.com/*"],
      "js": ["src/content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["locales/dict.json"],
      "matches": ["*://github.com/*"]
    }
  ]
}
